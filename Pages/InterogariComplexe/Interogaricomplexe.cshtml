@page
@model Editura.Pages.InterogariComplexe.InterogariModel
@{
    ViewData["Title"] = "Interogari";
}

<h2>Selectam numele autorilor si titlurile cartilor pentru carti publicate de o editura din bucuresti si care sunt publicate pe o data mai mica decat maximul dintre toti anii de publicare  </h2>

@if (Model.QueryResults1.Any())
{
    <table class="table">
        <thead>
            <tr>
                @foreach (var header in Model.QueryResults1.First().Item1.Split(','))
                {
                    <th>@header</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.QueryResults1)
            {
                <tr>
                    @foreach (var item in result.Item2.Split(','))
                    {
                        <td>@item</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nu există rezultate pentru această interogare.</p>
}

